# Auto Kremer — Lokale Entwicklungsvariablen (Beispiel)
# Kopiere diese Datei nach `.dev.vars` für Wrangler.
# WICHTIG: NIEMALS produktive Stripe-Schlüssel (`sk_live_...` / `rk_live_...`) hinterlegen!
# Die Anwendung blockiert Live-Keys zur Sicherheit automatisch zur Laufzeit.

PUBLIC_SITE_URL="http://localhost:8787"

# Stripe Sandbox (nur `sk_test_...`! Wenn leer, nutzt die App im Dev/Test den lokalen Sandbox-Simulator)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET="whsec_test_sandbox_local_secret"

# Cloudflare Turnstile (Offizielle Cloudflare Dummy-Testkeys für lokale Entwicklung)
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Resend Transactional Mail (Optional im Dev – Anfragen werden immer primär in D1 gespeichert)
RESEND_API_KEY=""
MAIL_FROM="Auto Kremer <noreply@auto-kremer.com>"
MAIL_TO="info@auto-kremer.com"

# Cloudflare Zero Trust Access (/admin Absicherung in Produktion; im lokalen Dev-Modus über DEV_ADMIN_BYPASS steuerbar)
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
DEV_ADMIN_TOKEN="dev-admin-local-only"
