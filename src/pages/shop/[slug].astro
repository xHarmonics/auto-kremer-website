---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AddToCartButton from '@/components/shop/AddToCartButton';
import ProductCard from '@/components/shop/ProductCard.astro';
import { getProductBySlug, searchProducts } from '@/db/queries/products';
import { formatEurCents } from '@/lib/format';
import { SITE_CONFIG } from '@/lib/site-config';

const { slug } = Astro.params;
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
  Astro.response.status = 404;
}

const relatedProducts = product
  ? (
      await searchProducts({
        modelSlug: product.models[0]?.slug,
        inStockOnly: true,
        limit: 5,
      })
    )
      .filter((p) => p.slug !== product.slug)
      .slice(0, 4)
  : [];

const siteOrigin = SITE_CONFIG.url;
const inStock = product ? product.availableStock > 0 && product.priceCents > 0 : false;

const productJsonLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `${product.oemNumber} — ${product.title}`,
      sku: product.oemNumber,
      mpn: product.oemNumber,
      description: product.description,
      category: product.category,
      image: [new URL(product.imageUrl, siteOrigin).toString()],
      brand: {
        '@type': 'Brand',
        name: 'Automobili Lamborghini',
      },
      offers: {
        '@type': 'Offer',
        url: `${siteOrigin}/shop/${product.slug}`,
        priceCurrency: 'EUR',
        ...(product.priceCents > 0
          ? { price: (product.priceCents / 100).toFixed(2) }
          : {}),
        availability: inStock
          ? 'https://schema.org/InStock'
          : 'https://schema.org/OutOfStock',
        itemCondition:
          product.condition === 'used_tested'
            ? 'https://schema.org/UsedCondition'
            : 'https://schema.org/NewCondition',
        seller: {
          '@type': 'AutoDealer',
          name: SITE_CONFIG.legalName,
        },
      },
    }
  : undefined;
---

{!product ? (
  <BaseLayout
    title="Ersatzteil nicht gefunden (404)"
    description="Das gesuchte Lamborghini-Ersatzteil konnte unter dieser Adresse nicht gefunden werden."
    noindex={true}
  >
    <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
      <p class="font-mono text-xs font-semibold tracking-widest text-gold uppercase">
        404 · Ersatzteil nicht gefunden
      </p>
      <h1 class="mt-4 font-display text-3xl font-semibold text-ink sm:text-4xl">
        Diese Teilenummer wurde im Katalog verschoben oder ist vergriffen.
      </h1>
      <p class="mt-4 text-base text-ink-muted">
        Nutzen Sie unsere Echtzeit-OEM-Suche oder senden Sie uns eine direkte Teileanfrage an unser Bonner Lager.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/shop"
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-canvas hover:bg-gold-hover"
        >
          Zum Ricambi Originali Katalog
        </a>
        <a
          href="/kontakt?thema=ersatzteil"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-surface px-6 py-3 text-sm font-semibold text-ink hover:border-gold hover:text-gold"
        >
          Ersatzteil anfragen
        </a>
      </div>
    </section>
  </BaseLayout>
) : (
  <BaseLayout
    title={`${product.oemNumber} — ${product.title} | Ricambi Originali`}
    description={product.description}
    canonicalPath={`/shop/${product.slug}`}
    ogImage={product.imageUrl}
    ogType="product"
    structuredData={productJsonLd}
  >
    <article class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:py-14">
      <!-- Breadcrumb -->
      <nav aria-label="Brotkrumen-Navigation" class="mb-6 text-xs text-ink-muted">
        <ol class="flex flex-wrap items-center gap-2 font-mono">
          <li>
            <a href="/" class="hover:text-gold">Startseite</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/shop" class="hover:text-gold">Teile-Shop</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="truncate text-ink">
            OEM {product.oemNumber}
          </li>
        </ol>
      </nav>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <!-- Left 6 Columns: Part Photo -->
        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-xl border border-border-subtle bg-surface">
            <div class="aspect-[4/3] bg-canvas">
              <img
                src={product.imageUrl}
                alt={product.imageAlt}
                width={640}
                height={480}
                fetchpriority="high"
                decoding="sync"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Right 6 Columns: Specs, Price, AddToCart, Legal Info -->
        <div class="lg:col-span-6">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded border border-gold/50 bg-surface px-3 py-1 font-mono text-xs font-semibold text-gold">
              OEM-Nr.: {product.oemNumber}
            </span>
            <span class="rounded border border-border-subtle bg-surface px-3 py-1 font-mono text-xs text-ink-muted">
              {product.category}
            </span>
          </div>

          <h1 class="mt-4 font-display text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
            {product.title}
          </h1>

          {product.models.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs text-ink-muted">Passend für:</span>
              {product.models.map((m) => (
                <a
                  href={`/shop?modell=${m.slug}`}
                  class="rounded-full border border-border-control bg-surface px-3 py-0.5 font-mono text-xs text-ink transition-colors hover:border-gold hover:text-gold"
                >
                  Lamborghini {m.label}
                </a>
              ))}
            </div>
          )}

          <!-- Price & Stock Box -->
          <div class="mt-6 rounded-xl border border-border-subtle bg-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-4">
              <div>
                <p class="font-mono text-3xl font-semibold text-ink">
                  {product.priceCents > 0
                    ? formatEurCents(product.priceCents)
                    : 'Preis auf Anfrage'}
                </p>
                <p class="mt-1 text-xs text-ink-muted">
                  inkl. {product.vatRatePercent} % gesetzl. MwSt., zzgl.{' '}
                  <a href="/versand" class="underline hover:text-gold">
                    Versandkosten
                  </a>
                </p>
              </div>

              <p class="font-mono text-xs font-semibold">
                {inStock ? (
                  <span class="text-status-available">
                    ● Sofort ab Lager Bonn ({product.availableStock} Stk.)
                  </span>
                ) : (
                  <span class="text-ink-muted">○ Derzeit auf Anfrage</span>
                )}
              </p>
            </div>

            <div class="mt-6">
              <AddToCartButton
                client:load
                product={{
                  id: product.id,
                  slug: product.slug,
                  oemNumber: product.oemNumber,
                  title: product.title,
                  priceCents: product.priceCents,
                  availableStock: product.availableStock,
                  imageUrl: product.imageUrl,
                }}
              />
            </div>
          </div>

          <!-- Technical Description & Statutory Guarantees (Replacing legacy Wix error) -->
          <div class="mt-6 space-y-5 rounded-xl border border-border-subtle bg-surface p-6 text-sm leading-relaxed text-ink-muted">
            <div>
              <h2 class="font-display text-base font-semibold text-ink">
                Produktinformation &amp; Herkunft
              </h2>
              <p class="mt-1.5">{product.description}</p>
            </div>

            <dl class="grid grid-cols-1 gap-3 border-t border-border-subtle pt-4 font-mono text-xs sm:grid-cols-2">
              <div>
                <dt class="text-ink-muted uppercase">Teilenummer (OEM)</dt>
                <dd class="mt-0.5 font-semibold text-ink">{product.oemNumber}</dd>
              </div>
              <div>
                <dt class="text-ink-muted uppercase">Zustand</dt>
                <dd class="mt-0.5 text-ink">
                  {product.condition === 'used_tested'
                    ? 'Geprüftes Original-Gebrauchtteil'
                    : 'Neu / New Old Stock (NOS)'}
                </dd>
              </div>
              <div>
                <dt class="text-ink-muted uppercase">Versandart</dt>
                <dd class="mt-0.5 text-ink">Versichertes Paket mit Tracking</dd>
              </div>
              <div>
                <dt class="text-ink-muted uppercase">Widerrufsrecht</dt>
                <dd class="mt-0.5 text-ink">
                  <a href="/widerruf" class="underline hover:text-gold">
                    14 Tage gesetzliches Widerrufsrecht
                  </a>
                </dd>
              </div>
            </dl>

            <div class="border-t border-border-subtle pt-4 text-xs">
              Unsicher bei der Kompatibilität mit Ihrer Fahrgestellnummer (FIN)?{' '}
              <a
                href={`/kontakt?thema=ersatzteil&teil=${encodeURIComponent(
                  `${product.oemNumber} - ${product.title}`
                )}`}
                class="font-semibold text-gold underline hover:text-gold-hover"
              >
                Techniker in Bonn kontaktieren →
              </a>
            </div>
          </div>
        </div>
      </div>

      {relatedProducts.length > 0 && (
        <section aria-labelledby="related-parts-heading" class="mt-16 border-t border-border-subtle pt-12">
          <div class="flex items-end justify-between gap-4">
            <h2 id="related-parts-heading" class="font-display text-2xl font-semibold text-ink">
              Weitere Originalteile dieser Baureihe
            </h2>
            <a href="/shop" class="font-mono text-xs text-gold hover:underline">
              Alle Teile ansehen →
            </a>
          </div>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {relatedProducts.map((rel) => (
              <ProductCard product={rel} />
            ))}
          </div>
        </section>
      )}
    </article>
  </BaseLayout>
)}
