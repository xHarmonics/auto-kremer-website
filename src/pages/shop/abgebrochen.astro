---
import BaseLayout from '@/layouts/BaseLayout.astro';
const orderNumber = Astro.url.searchParams.get('order');
---

<BaseLayout
  title="Bezahlvorgang abgebrochen"
  description="Der Bezahlvorgang wurde abgebrochen. Ihre Artikel befinden sich weiterhin im Warenkorb."
  noindex={true}
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-24">
    <div class="rounded-xl border border-border-subtle bg-surface p-8 text-center sm:p-12">
      <p class="font-mono text-xs font-semibold tracking-widest text-gold uppercase">
        Zahlung nicht abgeschlossen
      </p>
      <h1 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
        Ihr Warenkorb bleibt für Sie gespeichert.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-ink-muted">
        Der Bezahlvorgang{orderNumber ? ` (${orderNumber})` : ''} wurde abgebrochen und es erfolgte keine Belastung. Sie können Ihre Auswahl jederzeit im Warenkorb anpassen oder uns bei Fragen direkt in Bonn kontaktieren.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/shop"
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-canvas hover:bg-gold-hover"
        >
          Zurück zum Teile-Shop
        </a>
        <a
          href="/kontakt?thema=ersatzteil"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-canvas px-6 py-3 text-sm font-semibold text-ink hover:border-gold hover:text-gold"
        >
          Kauf auf Rechnung / Beratung anfragen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
