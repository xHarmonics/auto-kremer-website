---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@/lib/site-config';

const supercarPillars = [
  {
    code: '01 · INSPEKTION',
    title: 'Herstellerkonforme Inspektion & Systemdiagnose',
    description:
      'Regelmäßige Jahres- und Laufleistungsinspektionen nach exakten Werksvorgaben – inklusive elektronischer Steuergerätediagnose, Kupplungsverschleißmessung (E-Gear / ISR / LDF), Ventilspielkontrolle und lückenloser Dokumentation im Serviceheft.',
  },
  {
    code: '02 · REPARATUR',
    title: 'Mechanik-, Motoren- & Getriebeinstandsetzung',
    description:
      'Präzise Fehlersuche und Instandsetzung komplexer Zwölf-, Zehn- und Achtzylinder-Triebwerke, Schalt- und automatisierter Getriebe, Bremsanlagen, Hydrauliksysteme und Fahrwerkskomponenten unter Verwendung originaler Ersatzteile.',
  },
  {
    code: '03 · WARTUNG',
    title: 'Saisonpflege, Werterhalt & Concours-Aufbereitung',
    description:
      'Abgestimmte Hochleistungs-Schmierstoffe, Klima- und Kühlsystemservice, Standzeit-Vorbereitung vor und nach der Winterpause sowie schonende Fahrzeugwäsche und Lack-/Lederpflege – auf Wunsch auch samstags nach Terminvereinbarung.',
  },
  {
    code: '04 · RESTAURATION',
    title: 'Voll- & Teilrestauration klassischer Sportwagen',
    description:
      'Behutsame, originalgetreue Restaurierung historischer Lamborghini-, Alfa-Romeo- und Sportwagen-Klassiker. Vom Karosseriebau über Vergaserabstimmung und Kabelbaumfertigung bis zur authentischen Sattlerarbeit.',
  },
];

const workshopCatalog = [
  {
    title: 'Inspektion & Reparatur aller Sportwagen',
    detail: 'Spezialisiert auf Lamborghini, italienische Klassiker sowie ausgewählte Sport- und Alltagsfahrzeuge unseres Kundenstamms.',
  },
  {
    title: 'Öl- & Flüssigkeitsservice',
    detail: 'Wechsel von Motor-, Getriebe- und Differenzialölen sowie Brems- und Kühlflüssigkeiten nach Werksspezifikation.',
  },
  {
    title: 'Klimaanlagen-Service & Desinfektion',
    detail: 'Dichtheitsprüfung, Kältemittelbefüllung und Instandsetzung klassischer wie moderner Klimasysteme.',
  },
  {
    title: 'Saison-, Winter- & Urlaubs-Check',
    detail: 'Umfassende Sicherheits- und Funktionsdurchsicht vor längeren Ausfahrten, Alpenpässen oder Einlagerungsphasen.',
  },
  {
    title: 'Reifenservice & Rädereinlagerung',
    detail: 'Schonende Montage auf Hochleistungs- und Magnesium-/Zentralverschlussfelgen, Feinwuchten und fachgerechte Einlagerung.',
  },
  {
    title: 'HU / AU (TÜV-Abnahme im Haus)',
    detail: 'Vorbereitung und Durchführung der Haupt- und Abgasuntersuchung sowie H-Kennzeichen-Begutachtungen direkt bei uns in Bonn.',
  },
  {
    title: 'Unfallinstandsetzung & Karosseriearbeiten',
    detail: 'Fachgerechte Instandsetzung von Aluminium-, Stahl- und Carbon-Strukturen inklusive Gutachtenbegleitung.',
  },
  {
    title: 'Autoglas-Service',
    detail: 'Steinschlagreparatur und passgenauer Scheibenaustausch inklusive Beschaffung seltener Originalverglasungen.',
  },
  {
    title: 'Fahrzeugwäsche & Aufbereitung',
    detail: 'Handwäsche, Lackpolitur, Versiegelung und Lederpflege für Sammlerfahrzeuge – auch samstags nach vorheriger Vereinbarung.',
  },
  {
    title: 'Ricambi Originali Teileversorgung',
    detail: 'Direkter Zugriff auf unser eigenes Bonner Originalteilelager (350GT bis Urus) für kurze Standzeiten ohne monatelange Teilejagd.',
  },
];
---

<BaseLayout
  title="Meisterwerkstatt & Vollrestauration — Auto Kremer Bonn"
  description="Sportwagen-Meisterwerkstatt von Auto Kremer in Bonn: Lamborghini-Inspektion, Diagnose, Motoren- & Getriebereparatur, HU/AU, Karosseriebau und Vollrestauration seit 1967."
  canonicalPath="/werkstatt"
  ogImage="/media/vehicles/gallardo-manual-1.avif"
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- Hero -->
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
          Meisterwerkstatt · Diagnose · Vollrestauration
        </p>
        <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
          Erfahrung aus über fünf Jahrzehnten Hochleistungstechnik.
        </h1>
        <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
          Ein klassischer Sechsfach-Weber-Vergaser verlangt ein anderes Gehör als ein elektronisch gesteuertes E-Gear-Getriebe – wir beherrschen beides im eigenen Haus. In Bonn-Oberkassel betreuen wir Ihren Sportwagen mit Werks-Know-how, Spezialwerkzeugen und eigenem Originalteilelager.
        </p>
        <div class="mt-8 flex flex-wrap gap-3.5">
          <a
            href="/kontakt?thema=werkstatt"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-canvas hover:bg-gold-hover"
          >
            Werkstatt-Termin anfragen →
          </a>
          <a
            href={`tel:${SITE_CONFIG.contact.phoneSecondary}`}
            class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-surface px-5 py-3 font-mono text-sm font-medium text-ink hover:border-gold hover:text-gold"
          >
            Direktwahl Werkstatt: {SITE_CONFIG.contact.phoneSecondaryDisplay}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="overflow-hidden rounded-xl border border-gold/35 bg-surface">
          <img
            src="/media/vehicles/gallardo-manual-3.avif"
            alt="Lamborghini V10-Handschalter Technik & Cockpit bei Auto Kremer Bonn"
            width={1280}
            height={854}
            fetchpriority="high"
            class="aspect-[3/2] h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <!-- 4 Core Supercar Pillars -->
    <section aria-labelledby="pillars-heading" class="mt-16 border-t border-border-subtle pt-16">
      <h2
        id="pillars-heading"
        class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        Unsere vier Kernbereiche für Supersportwagen &amp; Klassiker.
      </h2>

      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        {supercarPillars.map((pillar) => (
          <article class="rounded-xl border border-border-subtle bg-surface p-6 sm:p-7">
            <p class="font-mono text-xs font-semibold tracking-wider text-gold uppercase">
              {pillar.code}
            </p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink">
              {pillar.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-muted">
              {pillar.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Full Service Catalog (Consolidated from /service) -->
    <section aria-labelledby="catalog-heading" class="mt-16 border-t border-border-subtle pt-16">
      <div class="max-w-3xl">
        <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
          Komplettservice aus einer Hand
        </p>
        <h2
          id="catalog-heading"
          class="mt-2 font-display text-2xl font-semibold tracking-tight text-ink sm:text-4xl"
        >
          Alle Werkstattleistungen im Überblick.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-ink-muted">
          Von der regelmäßigen Wartung bis zur Hauptuntersuchung im Haus bieten wir Ihnen alle Leistungen rund um Ihr Automobil am Standort Buchenweg 3 in Bonn.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {workshopCatalog.map((service) => (
          <div class="rounded-lg border border-border-subtle bg-surface/80 p-5">
            <h3 class="font-display text-base font-semibold text-ink">
              {service.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">
              {service.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Direct Booking Banner -->
    <div class="mt-16 flex flex-wrap items-center justify-between gap-6 rounded-xl border border-gold/40 bg-surface p-8">
      <div class="max-w-xl">
        <h2 class="font-display text-xl font-semibold text-ink sm:text-2xl">
          Persönliche Direktannahme nach Terminvereinbarung.
        </h2>
        <p class="mt-1.5 text-sm text-ink-muted">
          Gemeinsam besprechen wir den gewünschten Arbeitsumfang transparent am Fahrzeug. Auf Wunsch organisieren wir den geschlossenen Fahrzeugtransport zu uns nach Bonn.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/kontakt?thema=werkstatt"
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-canvas hover:bg-gold-hover"
        >
          Jetzt Servicetermin vereinbaren →
        </a>
        <a
          href="/shop"
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-canvas px-5 py-3 text-sm font-semibold text-ink hover:border-gold hover:text-gold"
        >
          Zum Originalteile-Shop
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
