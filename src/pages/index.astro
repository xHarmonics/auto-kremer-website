---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Auto Kremer Bonn — Sportwagen, Klassiker & Ricambi Originali seit 1967"
  description="Auto Kremer in Bonn: Exklusiver Sportwagen-Showroom, Meisterwerkstatt für Lamborghini & italienische Klassiker, Vollrestauration und über 100 originale Lamborghini-Ersatzteile."
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
    <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
      Automobilkultur in Bonn · Seit 1967
    </p>
    <h1 class="mt-4 max-w-4xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-6xl">
      Leidenschaft für italienische Hochleistungssportwagen &amp; zeitlose Klassiker.
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
      Verkauf handverlesener Sammlerfahrzeuge, diskrete Kommission, spezialisierte Meisterwerkstatt und weltweit versandfähiger Ricambi Originali Ersatzteilbestand.
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <a
        href="/fahrzeuge"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-gold-hover"
      >
        Aktuellen Fahrzeugbestand entdecken
      </a>
      <a
        href="/shop"
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-surface px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-gold hover:text-gold"
      >
        Ricambi Originali Teile-Shop
      </a>
    </div>
  </section>
</BaseLayout>
