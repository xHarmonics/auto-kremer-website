---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ConsignmentWizard from '@/components/forms/ConsignmentWizard';
import { getRuntimeEnv } from '@/lib/runtime-env';
import { SITE_CONFIG } from '@/lib/site-config';

const env = await getRuntimeEnv();
const turnstileSiteKey = env.PUBLIC_TURNSTILE_SITE_KEY ?? '1x00000000000000000000AA';

const steps = [
  {
    num: '01',
    title: 'Unverbindliche Ersteinschätzung',
    text: 'Übermitteln Sie uns Eckdaten und erste Aufnahmen Ihres Fahrzeugs. Innerhalb kürzester Zeit erhalten Sie eine fundierte Markteinschätzung durch Jason oder Marvin Kremer.',
  },
  {
    num: '02',
    title: 'Technische Prüfung & Aufbereitung',
    text: 'In unserer Bonner Meisterwerkstatt erstellen wir ein transparentes Zustandsprotokoll und bereiten Ihr Automobil optisch wie technisch auf Concours-Niveau vor.',
  },
  {
    num: '03',
    title: 'Vermarktung im Sammlernetzwerk',
    text: 'Professionelle Studiofotografie, internationale Ansprache verifizierter Sammler – oder auf Wunsch streng diskrete Off-Market-Vermittlung ohne öffentliche Inserate.',
  },
  {
    num: '04',
    title: 'Sichere Vertrags- & Zahlungsabwicklung',
    text: 'Wir übernehmen sämtliche Besichtigungen, Preisverhandlungen, Exportformalitäten und garantieren eine rechtssichere Auszahlung vor Fahrzeugübergabe.',
  },
];
---

<BaseLayout
  title="Fahrzeug-Kommission & Ankauf — Sportwagen verkaufen über Auto Kremer Bonn"
  description="Verkaufen Sie Ihren Lamborghini, Porsche oder klassischen Sportwagen zum Bestpreis in Kommission oder im schnellen Direktankauf über Auto Kremer in Bonn (seit 1967)."
  canonicalPath="/fahrzeug-verkaufen"
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- Hero Intro -->
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
        Kommission &amp; Direktankauf · Diskret seit 1967
      </p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        Ihr Klassiker oder Supersportwagen in besten Händen.
      </h1>
      <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
        Der Verkauf eines hochpreisigen Sammlerfahrzeugs erfordert technisches Tiefenwissen, gewachsenes Vertrauen und den direkten Draht zu internationalen Enthusiasten. Wir begleiten Sie vom ersten Gutachten bis zur sicheren Übergabe.
      </p>
    </div>

    <!-- 4-Step Process Grid -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="rounded-xl border border-border-subtle bg-surface p-6">
          <span class="font-mono text-xs font-semibold text-gold">{s.num}</span>
          <h2 class="mt-2 font-display text-lg font-semibold text-ink">{s.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.text}</p>
        </div>
      ))}
    </div>

    <!-- Wizard + Direct Contact Column -->
    <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <ConsignmentWizard client:load turnstileSiteKey={turnstileSiteKey} />
      </div>

      <aside class="space-y-6 lg:col-span-4">
        <div class="rounded-xl border border-gold/35 bg-surface p-6">
          <p class="font-mono text-xs font-semibold tracking-wider text-gold uppercase">
            Warum Auto Kremer Bonn?
          </p>
          <ul class="mt-4 space-y-3 text-sm text-ink-muted">
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="text-gold">◆</span>
              <span>Über 55 Jahre Markenerfahrung mit italienischen Sportwagen seit 1967</span>
            </li>
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="text-gold">◆</span>
              <span>Ausgezeichnet als <em>Automobili Lamborghini European Dealer of the Year</em></span>
            </li>
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="text-gold">◆</span>
              <span>Eigene Meisterwerkstatt &amp; originales Diagnose-Equipment im Haus</span>
            </li>
            <li class="flex gap-2.5">
              <span aria-hidden="true" class="text-gold">◆</span>
              <span>Geschlossener Hol- &amp; Bringservice in ganz Europa</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-border-subtle bg-surface p-6 text-sm">
          <h2 class="font-display text-base font-semibold text-ink">
            Persönlicher Direktkontakt
          </h2>
          <p class="mt-2 text-ink-muted">
            Sie möchten Ihr Anliegen lieber vorab telefonisch besprechen? Rufen Sie uns direkt in Bonn an:
          </p>
          <p class="mt-4 font-mono text-base font-semibold text-gold">
            <a href={`tel:${SITE_CONFIG.contact.phonePrimary}`} class="hover:underline">
              {SITE_CONFIG.contact.phonePrimaryDisplay}
            </a>
          </p>
          <p class="mt-1 text-xs text-ink-muted">
            Ansprechpartner: Jason Kremer &amp; Marvin Kremer
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
