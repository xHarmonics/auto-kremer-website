---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VehicleCard from '@/components/showroom/VehicleCard.astro';
import VehicleFilterBar from '@/components/showroom/VehicleFilterBar';
import { listShowroomVehicles } from '@/db/queries/vehicles';

const allVehicles = await listShowroomVehicles();
const brands = Array.from(new Set(allVehicles.map((v) => v.brand)));
const transmissions = Array.from(new Set(allVehicles.map((v) => v.transmission)));

const urlBrand = Astro.url.searchParams.get('marke') ?? 'all';
const urlTransmission = Astro.url.searchParams.get('getriebe') ?? 'all';
---

<BaseLayout
  title="Aktueller Fahrzeugbestand — Sportwagen & Klassiker im Showroom"
  description="Entdecken Sie handverlesene Lamborghini-, Porsche- und Alfa-Romeo-Sammlerfahrzeuge im Bonner Showroom von Auto Kremer. Werkstattgeprüft mit dokumentierter Historie."
  canonicalPath="/fahrzeuge"
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
    <!-- Editorial Page Header -->
    <div class="max-w-3xl">
      <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
        Showroom Bonn · Geprüfter Fahrzeugbestand
      </p>
      <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
        Handverlesene Sportwagen &amp; Sammlerfahrzeuge
      </h1>
      <p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
        Jedes Fahrzeug in unserem Bestand durchläuft eine detaillierte technische Prüfung in unserer Bonner Fachwerkstatt. Besichtigungen erfolgen nach persönlicher Terminvereinbarung in ruhiger Atmosphäre.
      </p>
    </div>

    <!-- Interactive Filter Island -->
    <div class="mt-8">
      <VehicleFilterBar
        client:load
        brands={brands}
        transmissions={transmissions}
        initialBrand={brands.includes(urlBrand) ? urlBrand : 'all'}
        initialTransmission={transmissions.includes(urlTransmission) ? urlTransmission : 'all'}
        totalCount={allVehicles.length}
      />
    </div>

    <!-- Vehicle Grid -->
    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {allVehicles.map((vehicle, index) => (
        <VehicleCard vehicle={vehicle} priority={index === 0} />
      ))}
    </div>

    <!-- Empty Filter Notice -->
    <div
      id="showroom-empty-state"
      hidden
      class="mt-8 rounded-lg border border-border-subtle bg-surface p-10 text-center"
    >
      <h2 class="font-display text-xl font-semibold text-ink">
        Keine Fahrzeuge für diese Filterkombination gefunden
      </h2>
      <p class="mt-2 text-sm text-ink-muted">
        Setzen Sie die Filter zurück oder kontaktieren Sie uns für unseren diskreten Off-Market-Bestand.
      </p>
    </div>

    <!-- Bespoke Sourcing & Consignment Banner -->
    <aside class="mt-16 rounded-xl border border-gold/30 bg-surface p-8 sm:p-10">
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
        <div class="max-w-2xl">
          <p class="font-mono text-xs font-semibold tracking-wider text-gold uppercase">
            Suchauftrag &amp; Kommission
          </p>
          <h2 class="mt-2 font-display text-2xl font-semibold text-ink sm:text-3xl">
            Sie suchen ein bestimmtes Modell oder möchten Ihren Klassiker veräußern?
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">
            Über unser gewachsenes europäisches Sammlernetzwerk seit 1967 vermitteln wir regelmäßig seltene Lamborghini- und Sportwagen-Raritäten – auf Wunsch vollkommen diskret.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="/fahrzeug-verkaufen"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-gold px-5 py-3 text-sm font-semibold text-canvas transition-colors hover:bg-gold-hover"
          >
            Fahrzeug in Kommission geben
          </a>
          <a
            href="/referenzen"
            class="inline-flex min-h-12 items-center justify-center rounded-md border border-border-control bg-canvas px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-gold hover:text-gold"
          >
            Verkaufte Referenzen ansehen
          </a>
        </div>
      </div>
    </aside>
  </section>
</BaseLayout>
