---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@/lib/site-config';
---

<BaseLayout
  title="Versand & Zahlungsbedingungen | Ricambi Originali Shop — Auto Kremer Bonn"
  description="Transparente Versandkosten für Deutschland, die Europäische Union und weltweiten Expressversand sowie akzeptierte Zahlungsarten im Auto Kremer Online-Shop."
  canonicalPath="/versand"
>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
    <p class="font-mono text-xs font-semibold tracking-[0.22em] text-gold uppercase">
      Shop-Informationen · Weltweiter Teileversand
    </p>
    <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-5xl">
      Versand &amp; Zahlungsbedingungen
    </h1>
    <p class="mt-4 text-base leading-relaxed text-ink-muted">
      Alle lagernden Original-Ersatzteile versenden wir sorgfältig geschützt und transportversichert direkt aus unserem Bonner Lager (Buchenweg 3, 53227 Bonn).
    </p>

    <!-- Accessible Responsive Table (@container query + sticky headers) -->
    <section aria-labelledby="shipping-rates-heading" class="mt-10">
      <h2 id="shipping-rates-heading" class="font-display text-xl font-semibold text-ink">
        1. Versandzonen, Tarife &amp; Regellaufzeiten
      </h2>

      <div
        tabindex="0"
        role="region"
        aria-labelledby="shipping-table-caption"
        class="ak-table-region mt-4 rounded-xl border border-border-subtle bg-surface"
      >
        <table>
          <caption id="shipping-table-caption" class="sr-only">
            Übersicht der Versandkosten und Lieferzeiten nach Lieferregion
          </caption>
          <thead>
            <tr class="border-b border-border-subtle text-left font-mono text-xs text-ink-muted uppercase">
              <th scope="col" class="px-5 py-3.5">Lieferzone</th>
              <th scope="col" class="px-5 py-3.5">Versandart</th>
              <th scope="col" class="px-5 py-3.5">Regellaufzeit</th>
              <th scope="col" class="px-5 py-3.5 text-right">Versandpauschale</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-subtle text-sm">
            <tr>
              <th scope="row" class="px-5 py-4 text-left font-semibold text-ink">
                Deutschland (Standard)
              </th>
              <td data-col-label="Versandart" class="px-5 py-4 text-ink-muted">
                DHL / UPS Versichertes Paket mit Sendungsverfolgung
              </td>
              <td data-col-label="Laufzeit" class="px-5 py-4 font-mono text-xs text-ink">
                2–4 Werktage
              </td>
              <td data-col-label="Kosten" class="px-5 py-4 text-right font-mono font-semibold text-ink">
                9,90 €
              </td>
            </tr>
            <tr>
              <th scope="row" class="px-5 py-4 text-left font-semibold text-status-available">
                Deutschland ab 500,00 € Warenwert
              </th>
              <td data-col-label="Versandart" class="px-5 py-4 text-ink-muted">
                Versicherter Wertversand inklusive Tracking
              </td>
              <td data-col-label="Laufzeit" class="px-5 py-4 font-mono text-xs text-ink">
                2–4 Werktage
              </td>
              <td data-col-label="Kosten" class="px-5 py-4 text-right font-mono font-semibold text-status-available">
                0,00 € (versandkostenfrei)
              </td>
            </tr>
            <tr>
              <th scope="row" class="px-5 py-4 text-left font-semibold text-ink">
                Europäische Union (EU)
              </th>
              <td data-col-label="Versandart" class="px-5 py-4 text-ink-muted">
                DHL / UPS International Versichert
              </td>
              <td data-col-label="Laufzeit" class="px-5 py-4 font-mono text-xs text-ink">
                3–7 Werktage
              </td>
              <td data-col-label="Kosten" class="px-5 py-4 text-right font-mono font-semibold text-ink">
                24,90 €
              </td>
            </tr>
            <tr>
              <th scope="row" class="px-5 py-4 text-left font-semibold text-ink">
                Schweiz, UK &amp; Weltweit
              </th>
              <td data-col-label="Versandart" class="px-5 py-4 text-ink-muted">
                Internationaler Express-/Wertversand (exkl. Drittlandszölle)
              </td>
              <td data-col-label="Laufzeit" class="px-5 py-4 font-mono text-xs text-ink">
                5–10 Werktage
              </td>
              <td data-col-label="Kosten" class="px-5 py-4 text-right font-mono font-semibold text-ink">
                59,00 €
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-ink-muted">
        Alle innerhalb Deutschlands und der EU ausgewiesenen Versandkosten verstehen sich inklusive 19 % gesetzlicher Umsatzsteuer. Sperrgutpositionen (z. B. komplette Stoßfänger, Auspuffanlagen oder Karosserieteile per Spedition) stimmen wir transparent mit Ihnen ab; Selbstabholung im Teilelager Bonn ({SITE_CONFIG.address.street}, {SITE_CONFIG.address.postalCode} {SITE_CONFIG.address.city}) ist nach Terminabsprache kostenfrei möglich.
      </p>
    </section>

    <section aria-labelledby="payment-methods-heading" class="mt-12 rounded-xl border border-border-subtle bg-surface p-6 text-sm leading-relaxed text-ink-muted sm:p-8">
      <h2 id="payment-methods-heading" class="font-display text-xl font-semibold text-ink">
        2. Sichere Zahlungsarten (Stripe Checkout)
      </h2>
      <p class="mt-2">
        Im Online-Shop stehen Ihnen über unseren PCI-DSS-zertifizierten Zahlungspartner <strong>Stripe</strong> folgende Zahlungsarten ohne Zusatzgebühren zur Verfügung:
      </p>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 font-mono text-xs text-ink sm:grid-cols-2">
        <li>◆ Kredit- &amp; Debitkarte (Visa, Mastercard, American Express)</li>
        <li>◆ Apple Pay &amp; Google Pay</li>
        <li>◆ SEPA-Lastschrift / Banküberweisung</li>
        <li>◆ Klarna / PayPal (je nach Länderverfügbarkeit)</li>
      </ul>
    </section>
  </article>
</BaseLayout>
