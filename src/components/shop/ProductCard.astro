---
import type { ProductWithModels } from '@/db/queries/products';
import { formatEurCents } from '@/lib/format';

interface Props {
  product: ProductWithModels;
}

const { product } = Astro.props;
const inStock = product.availableStock > 0 && product.priceCents > 0;
const inquiryHref = `/kontakt?thema=ersatzteil&teil=${encodeURIComponent(
  `${product.oemNumber} - ${product.title}`
)}`;
---

<article class="group flex flex-col justify-between overflow-hidden rounded-lg border border-border-subtle bg-surface transition-colors hover:border-gold/60 hover:bg-surface-elevated">
  <div>
    <a
      href={`/shop/${product.slug}`}
      class="relative block aspect-[4/3] overflow-hidden bg-canvas"
    >
      <img
        src={product.imageUrl}
        alt={product.imageAlt}
        width={480}
        height={360}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
      <div class="absolute top-2.5 left-2.5">
        <span class="rounded border border-gold/40 bg-canvas/90 px-2 py-0.5 font-mono text-xs font-semibold text-gold backdrop-blur-sm">
          OEM {product.oemNumber}
        </span>
      </div>
    </a>

    <div class="p-5">
      <div class="flex flex-wrap items-center gap-1.5">
        {product.models.length > 0 ? (
          product.models.slice(0, 3).map((m) => (
            <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[10px] text-ink-muted uppercase">
              {m.label}
            </span>
          ))
        ) : (
          <span class="rounded bg-canvas px-2 py-0.5 font-mono text-[10px] text-ink-muted uppercase">
            Ricambi Originali
          </span>
        )}
      </div>

      <h3 class="mt-2.5 font-display text-base font-semibold leading-snug text-ink transition-colors group-hover:text-gold">
        <a href={`/shop/${product.slug}`}>{product.title}</a>
      </h3>

      <p class="mt-2 flex items-center gap-1.5 font-mono text-xs">
        {inStock ? (
          <>
            <span aria-hidden="true" class="text-status-available">●</span>
            <span class="text-status-available">
              Auf Lager ({product.availableStock} Stk.)
            </span>
          </>
        ) : (
          <>
            <span aria-hidden="true" class="text-ink-muted">○</span>
            <span class="text-ink-muted">Derzeit vergriffen / Auf Anfrage</span>
          </>
        )}
      </p>
    </div>
  </div>

  <div class="border-t border-border-subtle p-5 pt-4">
    <div class="flex items-end justify-between gap-3">
      <div>
        <p class="font-mono text-lg font-semibold text-ink">
          {product.priceCents > 0 ? formatEurCents(product.priceCents) : 'Preis auf Anfrage'}
        </p>
        <p class="text-[11px] text-ink-muted">
          inkl. 19 % MwSt., zzgl.{' '}
          <a href="/versand" class="underline hover:text-gold">
            Versandkosten
          </a>
        </p>
      </div>
      {inStock ? (
        <a
          href={`/shop/${product.slug}`}
          class="inline-flex min-h-11 items-center rounded-md bg-gold px-3.5 py-2 text-xs font-semibold text-canvas transition-colors hover:bg-gold-hover"
        >
          Details →
        </a>
      ) : (
        <a
          href={inquiryHref}
          class="inline-flex min-h-11 items-center rounded-md border border-border-control bg-canvas px-3 py-2 text-xs font-semibold text-ink transition-colors hover:border-gold hover:text-gold"
        >
          Anfragen
        </a>
      )}
    </div>
  </div>
</article>
