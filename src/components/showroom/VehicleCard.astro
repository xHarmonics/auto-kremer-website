---
import type { VehicleWithImages } from '@/db/queries/vehicles';
import {
  formatMileageKm,
  formatPower,
  formatVehiclePriceDisplay,
} from '@/lib/format';

interface Props {
  vehicle: VehicleWithImages;
  priority?: boolean;
}

const { vehicle, priority = false } = Astro.props;
const priceInfo = formatVehiclePriceDisplay(vehicle);

const statusConfig = {
  available: {
    label: 'Sofort verfügbar',
    dotClass: 'bg-status-available',
    badgeClass: 'border-status-available/40 bg-canvas/90 text-status-available',
  },
  reserved: {
    label: 'Reserviert',
    dotClass: 'bg-status-reserved',
    badgeClass: 'border-status-reserved/40 bg-canvas/90 text-status-reserved',
  },
  sold: {
    label: 'Verkauft · Referenz',
    dotClass: 'bg-status-sold',
    badgeClass: 'border-border-control bg-canvas/90 text-ink-muted',
  },
}[vehicle.status];

const coverUrl = vehicle.coverImage?.url ?? '/favicon.svg';
const coverAlt = vehicle.coverImage?.alt ?? vehicle.title;
---

<article
  data-vehicle-card
  data-brand={vehicle.brand}
  data-transmission={vehicle.transmission}
  class="group flex flex-col overflow-hidden rounded-lg border border-border-subtle bg-surface transition-colors duration-200 hover:border-gold/60 hover:bg-surface-elevated"
>
  <a
    href={`/fahrzeuge/${vehicle.slug}`}
    class="relative block aspect-[3/2] overflow-hidden bg-canvas"
  >
    <img
      src={coverUrl}
      alt={coverAlt}
      width={1280}
      height={854}
      fetchpriority={priority ? 'high' : undefined}
      loading={priority ? undefined : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-canvas/75 via-transparent to-transparent" />

    <div class="absolute top-3 left-3 flex flex-wrap items-center gap-2">
      <span
        class:list={[
          'inline-flex items-center gap-1.5 rounded border px-2.5 py-1 font-mono text-[11px] font-semibold tracking-wide uppercase backdrop-blur-sm',
          statusConfig.badgeClass,
        ]}
      >
        <span aria-hidden="true" class:list={['h-2 w-2 rounded-full', statusConfig.dotClass]} />
        {statusConfig.label}
      </span>
    </div>

    <div class="absolute bottom-3 left-3">
      <span class="rounded bg-canvas/85 px-2.5 py-1 font-mono text-xs font-medium text-gold backdrop-blur-sm">
        {vehicle.brand} · {vehicle.year}
      </span>
    </div>
  </a>

  <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
    <div>
      <h2 class="font-display text-xl font-semibold leading-snug text-ink transition-colors group-hover:text-gold">
        <a href={`/fahrzeuge/${vehicle.slug}`} class="focus-visible:underline">
          {vehicle.title}
        </a>
      </h2>

      <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-ink-muted">
        {vehicle.summary}
      </p>

      <!-- Monospace Technical Spec Strip -->
      <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-2.5 border-y border-border-subtle py-3.5 font-mono text-xs">
        <div>
          <dt class="text-[10px] tracking-wider text-ink-muted uppercase">Baujahr</dt>
          <dd class="mt-0.5 text-ink">{vehicle.year}</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-wider text-ink-muted uppercase">Laufleistung</dt>
          <dd class="mt-0.5 text-ink">{formatMileageKm(vehicle.mileageKm)}</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-wider text-ink-muted uppercase">Leistung</dt>
          <dd class="mt-0.5 text-ink">{formatPower(vehicle.powerPs, vehicle.powerKw)}</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-wider text-ink-muted uppercase">Getriebe</dt>
          <dd class="mt-0.5 truncate text-ink">{vehicle.transmission}</dd>
        </div>
      </dl>
    </div>

    <div class="mt-5 flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-lg font-semibold text-ink">{priceInfo.primary}</p>
        <p class="text-[11px] text-ink-muted">{priceInfo.taxNote}</p>
      </div>
      <a
        href={`/fahrzeuge/${vehicle.slug}`}
        class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border-control bg-canvas px-4 py-2 text-xs font-semibold tracking-wide text-ink uppercase transition-colors hover:border-gold hover:text-gold"
      >
        <span>Exposé</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>
